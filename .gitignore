# Nested upstream Git metadata is removed before vendoring.
VIRTUAL_HOME/virtualhome/.git/
VIRTUAL_HOME/virtualhome_unity_project/.git/

# Unity local cache and machine-specific editor state.
VIRTUAL_HOME/virtualhome_unity_project/[Ll]ibrary/
VIRTUAL_HOME/virtualhome_unity_project/[Ll]ogs/
VIRTUAL_HOME/virtualhome_unity_project/[Tt]emp/
VIRTUAL_HOME/virtualhome_unity_project/[Uu]ser[Ss]ettings/
