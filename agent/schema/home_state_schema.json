{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HomeStateSnapshot",
  "description": "家居状态快照：Agent 层与感知层（摄像头/YOLO 检测进程）之间通过文件 IPC 交换的数据契约。感知进程原子写入，Agent 轮询读取。",
  "type": "object",
  "required": ["timestamp", "rooms"],
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "快照生成时间，格式 YYYY-MM-DD HH:MM:SS（24 小时制，便于判断白天/夜间）"
    },
    "rooms": {
      "type": "array",
      "description": "房间列表，每个房间包含该房间检测到的对象",
      "items": { "$ref": "#/definitions/room" }
    }
  },
  "definitions": {
    "room": {
      "type": "object",
      "required": ["room", "objects"],
      "properties": {
        "room": {
          "type": "string",
          "description": "房间名，枚举见契约文档（客厅/卧室/厨房/卫生间等）"
        },
        "objects": {
          "type": "array",
          "items": { "$ref": "#/definitions/object" }
        }
      }
    },
    "object": {
      "type": "object",
      "required": ["category"],
      "description": "检测对象。按 category 分派不同字段，新增能力只扩展 category 枚举，不改结构。",
      "properties": {
        "category": {
          "type": "string",
          "enum": ["person", "light", "pet", "appliance"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "category": { "const": "person" },
            "count": { "type": "integer", "minimum": 0 },
            "pose": {
              "type": ["string", "null"],
              "enum": ["standing", "sitting", "lying", null]
            }
          },
          "required": ["count", "pose"]
        },
        {
          "properties": {
            "category": { "const": "light" },
            "state": { "type": "string", "enum": ["on", "off"] }
          },
          "required": ["state"]
        },
        {
          "properties": {
            "category": { "const": "pet" },
            "count": { "type": "integer", "minimum": 0 }
          },
          "required": ["count"]
        },
        {
          "properties": {
            "category": { "const": "appliance" },
            "name": { "type": "string" },
            "state": { "type": "string", "enum": ["on", "off", "standby"] }
          },
          "required": ["name", "state"]
        }
      ]
    }
  }
}
