# A210 智能家居边缘视觉 Agent
#
# 环境变量说明（赛题规则：API Key 绝不硬编码在源码中）：
#   DASHSCOPE_API_KEY   云端大模型 API Key
#   DASHSCOPE_BASE_URL  云端大模型 OpenAI 兼容端点
#   DASHSCOPE_MODEL     模型名
#   HOME_STATE_FILE     家居状态快照文件路径
#   BACKEND             端侧后端 mock（本地）/ real（上板）
#   WEB_HOST / WEB_PORT Web 监听地址

DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.6-flash

# 本地 mock：相对路径即可；上板 real：改成绝对路径，如 /tmp/home_state.json
HOME_STATE_FILE=./mock/home_state.json

# 端侧后端：本地用 mock；上板接队友真实采集/推理后改成 real
BACKEND=mock

WEB_HOST=0.0.0.0
WEB_PORT=8000
