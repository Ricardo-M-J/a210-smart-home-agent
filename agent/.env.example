# A210 智能家居边缘视觉 Agent
#
# 环境变量说明（赛题规则：API Key 绝不硬编码在源码中）：
#   DASHSCOPE_API_KEY   云端大模型 API Key
#   DASHSCOPE_BASE_URL  云端大模型 OpenAI 兼容端点
#   DASHSCOPE_MODEL     模型名
#   HOME_STATE_FILE     家居状态快照文件路径
#   BACKEND             端侧后端 mock（本地）/ real（上板）
#   WEB_HOST / WEB_PORT Web 监听地址

DASHSCOPE_API_KEY=your api key
DASHSCOPE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.6-flash

# 本地 mock：相对路径即可；上板 real：改成绝对路径，如 /tmp/home_state.json
HOME_STATE_FILE=./mock/home_state.json

# 端侧后端：本地用 mock；上板接队友真实采集/推理后改成 real
BACKEND=mock

# VirtualHome backend (optional):
# BACKEND=virtualhome
# VIRTUAL_HOME_DIR=../VIRTUAL_HOME
# VIRTUAL_HOME_SCENE=kitchen_pet
# VIRTUAL_HOME_FRAME_STREAM_FILE=outputs/showcase_panel/interface_samples/virtualhome_frame_stream_sample.jsonl
# VIRTUAL_HOME_EXTERNAL_RESULT_FILE=outputs/showcase_panel/interface_samples/external_result_sample.jsonl
# VIRTUAL_HOME_FEEDBACK_SAMPLE_FILE=outputs/showcase_panel/interface_samples/virtualhome_feedback_action_sample.jsonl
# VIRTUAL_HOME_FEEDBACK_FILE=outputs/agent_feedback/virtualhome_feedback_actions.jsonl
# VIRTUAL_HOME_UNITY_CONTROL=1
# VIRTUAL_HOME_UNITY_PORT=8080
# VIRTUAL_HOME_PYTHON=../VIRTUAL_HOME/vhome/Scripts/python.exe

WEB_HOST=0.0.0.0
WEB_PORT=8019

# Local VirtualHome panel / bridge default agent URL.
A210_AGENT_URL=http://127.0.0.1:8019
